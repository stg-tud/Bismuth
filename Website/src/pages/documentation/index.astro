---
import { url } from "../../lib/url";
import Base from "../../layouts/Base.astro";
import { libraries, manualPath, site } from "../../data/site";
---

<Base title="Libraries">
	<section class="header">
		<div class="container">
			<h1>Libraries</h1>
			<p class="lead">
				Besides research prototypes, Bismuth contains libraries that are ready for building local-first applications. They
				are published separately and can be used individually, on the JVM, in the browser via Scala.js, and natively via Scala Native (group id <code>de.tu-darmstadt.stg</code>). We document the{" "}
				<b>RDTs</b> (algebraic replicated data types) and <b>Reactives</b> libraries with a hands-on manual each, and all
				libraries with generated API documentation (Scaladoc). For everything else, the{" "}
				<a href={site.repo}>repository</a> describes how to build the project and gives an overview of all modules.
			</p>
		</div>
	</section>
	<section class="section bg-light">
		<div class="container grid">
			{
				libraries.map((l) => (
					<div class="lib-card">
						<h3>{l.title}</h3>
						<p>{l.summary}</p>
						<div class="lib-links">
							{l.manual ? (
								<a class="lib-link primary" href={url(manualPath(l.manual))}>
									<span>Manual</span>
									<small>{l.manual}</small>
								</a>
							) : (
								<span class="lib-link disabled">
									<span>Manual</span>
									<small>not yet available</small>
								</span>
							)}
							<div class="lib-link">
								<span>Scaladoc</span>
								<small class="platforms">
									{l.scaladoc.map((d) => <a href={d.href}>{d.platform} ↗</a>)}
								</small>
							</div>
							<a class="lib-link" href={l.maven}>
								<span>Artifacts ↗</span>
								<small><code>{l.artifact}</code></small>
							</a>
						</div>
					</div>
				))
			}
		</div>
	</section>
</Base>
