---
import Base from "../../layouts/Base.astro";
import { demos } from "../../data/site";
---

<Base title="Demos">
	<section class="header">
		<div class="container">
			<h1>Demos</h1>
			<p class="lead">
				Case-study web applications built with Bismuth, running fully in your browser. Open a demo in multiple tabs to see
				replication in action.
			</p>
			<p class="notice">
				Note: the demos were only recently integrated into this website and are likely not quite working at the moment.
			</p>
		</div>
	</section>
	<section class="section bg-light">
		<div class="container">
			<div class="demo-cards" role="tablist">
				{
					demos.map((d) => (
						<button class="card card-padded" role="tab" data-demo={d.id} data-summary={d.summary} data-bridged={d.bridged ? "true" : undefined} aria-selected="false">
							<span class="icon" aria-hidden="true">{d.icon}</span>
							<strong>{d.title}</strong>
							<span class="text">{d.summary}</span>
						</button>
					))
				}
			</div>
			<p id="demo-hint">Select a demo above to run it here.</p>
			<p id="demo-summary" hidden>
				<span></span> <a id="demo-open" target="_blank">Open in new tab ↗</a>
			</p>
			<div id="demo-frames"></div>
			<p id="demo-instances" hidden>
				<button id="demo-add" class="hero">Add instance</button>
				Each instance is a separate replica of the case study, all synchronized through this page.
			</p>
			<div id="demo-connections"></div>
		</div>
	</section>
</Base>

<script>
	import { url } from "../../lib/url";

	const frames = document.getElementById("demo-frames")!;
	const instances = document.getElementById("demo-instances")!;
	const addButton = document.getElementById("demo-add") as HTMLButtonElement;
	const connections = document.getElementById("demo-connections")!;
	const open = document.getElementById("demo-open") as HTMLAnchorElement;
	const summary = document.getElementById("demo-summary")!;
	const hint = document.getElementById("demo-hint")!;
	const buttons = [...document.querySelectorAll<HTMLButtonElement>(".demo-cards button")];

	type Host = { connect(bridge: string): void; stop(): void };

	let current: string | undefined;
	let host: Host | undefined;

	function addFrame(src: string, removable: boolean): HTMLIFrameElement {
		const wrapper = document.createElement("div");
		wrapper.className = "demo-instance";
		const frame = document.createElement("iframe");
		frame.className = "card demo-frame";
		frame.title = "Demo";
		frame.src = src;
		wrapper.append(frame);
		if (removable) {
			const close = document.createElement("button");
			close.className = "demo-instance-close";
			close.title = "Remove instance";
			close.textContent = "×";
			close.addEventListener("click", () => wrapper.remove());
			wrapper.append(close);
		}
		frames.append(wrapper);
		return frame;
	}

	// bridged demos connect to a relay on this page (via a broadcast channel only known to this page and the iframe),
	// which handles the WebRTC connections to other replicas, see webapps.DemoBridge
	function addInstance(id: string, removable: boolean): HTMLIFrameElement | undefined {
		if (!host) return;
		const bridge = crypto.randomUUID();
		host.connect(bridge);
		return addFrame(`${url(`/examples/${id}.html`)}?bridge=${bridge}`, removable);
	}

	async function load(id: string, bridged: boolean) {
		host?.stop();
		host = undefined;
		frames.replaceChildren();
		instances.hidden = !bridged;
		frames.classList.toggle("multi", bridged);
		if (!bridged) {
			addFrame(url(`/examples/${id}.html`), false);
			return;
		}
		// @ts-ignore the Scala.js output is untyped (alias defined in astro.config.mjs)
		const { DemoBridgeHost } = await import("scalajs:examples");
		if (current !== id) return; // another demo was selected in the meantime
		host = DemoBridgeHost(id, connections) as Host;
		addInstance(id, false);
	}

	addButton.addEventListener("click", () => {
		if (current) addInstance(current, true)?.scrollIntoView({ behavior: "smooth", block: "nearest" });
	});

	// nothing is loaded until a demo is selected; the selected demo is kept in the url hash (e.g. demos/#tabular), so it survives reloads and can be linked
	function select(btn: HTMLButtonElement, scroll: boolean) {
		buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
		const id = btn.dataset.demo!;
		if (current !== id) {
			current = id;
			load(id, btn.dataset.bridged === "true");
		}
		open.href = url(`/examples/${id}.html`);
		summary.querySelector("span")!.textContent = btn.dataset.summary ?? "";
		summary.hidden = false;
		hint.hidden = true;
		history.replaceState(null, "", `#${id}`);
		if (scroll) frames.scrollIntoView({ behavior: "smooth", block: "nearest" });
	}

	for (const btn of buttons) btn.addEventListener("click", () => select(btn, true));

	const initial = buttons.find((b) => b.dataset.demo === location.hash.slice(1));
	if (initial) select(initial, false);
</script>
