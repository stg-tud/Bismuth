---
import Base from "../../layouts/Base.astro";
import { demos } from "../../data/site";
---

<Base title="Demos">
	<section class="header">
		<div class="container">
			<h1>Demos</h1>
			<p class="lead">
				Case-study web applications built with Bismuth, running fully in your browser. Open a demo in multiple tabs to see
				replication in action.
			</p>
			<p class="notice">
				Note: the demos were only recently integrated into this website and are likely not quite working at the moment.
			</p>
		</div>
	</section>
	<section class="section bg-light">
		<div class="container">
			<div class="demo-cards" role="tablist">
				{
					demos.map((d) => (
						<button role="tab" data-demo={d.id} data-summary={d.summary} aria-selected="false">
							<span class="icon" aria-hidden="true">{d.icon}</span>
							<strong>{d.title}</strong>
							<span class="text">{d.summary}</span>
						</button>
					))
				}
			</div>
			<p id="demo-hint">Select a demo above to run it here.</p>
			<p id="demo-summary" hidden>
				<span></span> <a id="demo-open" target="_blank">Open in new tab ↗</a>
			</p>
			<iframe id="demo-frame" class="demo-frame" title="Demo" hidden></iframe>
		</div>
	</section>
</Base>

<script>
	import { url } from "../../lib/url";

	const frame = document.getElementById("demo-frame") as HTMLIFrameElement;
	const open = document.getElementById("demo-open") as HTMLAnchorElement;
	const summary = document.getElementById("demo-summary")!;
	const hint = document.getElementById("demo-hint")!;
	const buttons = [...document.querySelectorAll<HTMLButtonElement>(".demo-cards button")];

	// nothing is loaded until a demo is selected; the selected demo is kept in the url hash (e.g. demos/#tabular), so it survives reloads and can be linked
	function select(btn: HTMLButtonElement, scroll: boolean) {
		buttons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
		const demo = url(`/examples/${btn.dataset.demo}.html`);
		if (frame.getAttribute("src") !== demo) frame.src = demo;
		open.href = demo;
		summary.querySelector("span")!.textContent = btn.dataset.summary ?? "";
		summary.hidden = false;
		frame.hidden = false;
		hint.hidden = true;
		history.replaceState(null, "", `#${btn.dataset.demo}`);
		if (scroll) frame.scrollIntoView({ behavior: "smooth", block: "nearest" });
	}

	for (const btn of buttons) btn.addEventListener("click", () => select(btn, true));

	const initial = buttons.find((b) => b.dataset.demo === location.hash.slice(1));
	if (initial) select(initial, false);
</script>
