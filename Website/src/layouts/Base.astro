---
import { url } from "../lib/url";
import "../styles/global.css";
import { site } from "../data/site";

interface Props {
	title?: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
	{ href: url("/"), label: "Projects" },
	{ href: url("/documentation/"), label: "Documentation" },
	{ href: url("/demos/"), label: "Demos" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={site.description} />
		<link rel="icon" type="image/svg+xml" href={url("/logo.svg")} />
		<meta name="theme-color" content="#5c4cc0" />
		<title>{title ? `${title} – ${site.title}` : site.title}</title>
	</head>
	<body>
		<header class="navbar">
			<div class="container">
				<a class="brand" href={url("/")}><img src={url("/logo.svg")} alt="" /><span>Bismuth</span></a>
				<nav class="nav-links">
					{nav.map((n) => <a class:list={["nav-link", { active: path === n.href || path + "/" === n.href }]} href={n.href}>{n.label}</a>)}
					<span class="pills">
						<a class="pill-left" href={site.scaladoc}>API</a>
						<a class="pill-right" href={site.repo} target="_blank" rel="noopener">REPO</a>
					</span>
				</nav>
			</div>
		</header>
		<main><slot /></main>
		<footer>
			<div class="container cols">
				<div style="max-width: 22rem">
					<strong class="brand-footer"><img src={url("/logo.svg")} alt="" />Bismuth</strong>
					<span>{site.description}</span>
				</div>
				<div>
					<a href={url("/")}>Projects</a>
					<a href={url("/documentation/")}>Documentation</a>
					<a href={url("/demos/")}>Demos</a>
				</div>
				<div>
					<a href={site.scaladoc}>API Docs</a>
					<a href={site.repo} target="_blank" rel="noopener">Repository</a>
					<a href="https://matrix.to/#/#difosys:matrix.tu-darmstadt.de">Matrix Chat</a>
				</div>
				<div>
					<span>Technical University of Darmstadt</span>
					<span>Software Technology Group</span>
					<a href="https://www.stg.tu-darmstadt.de/">stg.tu-darmstadt.de</a>
				</div>
			</div>
			<div class="bottom">
				Bismuth is available under the Apache 2 License. © {new Date().getFullYear()} The Bismuth Contributors
			</div>
		</footer>
	</body>
</html>
