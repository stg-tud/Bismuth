---
// Standalone page (no site chrome) hosting one Scala.js web case study.
// The JS is produced by `sbt examplesJS/fastLinkJS` / `fullLinkJS` into Website/target/generated_js.
import "../examples/style.css";
import { url } from "../lib/url";

interface Props {
	title: string;
	app: string;
	/** show the default footer */
	footer?: boolean;
}
const { title, app, footer = true } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} · WebApp Case Studies</title>
	</head>
	<body data-app={app}>
		<section id="app">
			<noscript>
				<div style="padding:2em;text-align:center;font-size:2em">Please enable JavaScript!</div>
			</noscript>
		</section>
		{
			footer && (
				<footer class="info">
					<p><a href={url("/demos/")} target="_top">← All Case Studies</a></p>
					<p>Created by the <a href="https://www.st.informatik.tu-darmstadt.de/">Software Technology Group</a></p>
					<slot name="footer" />
				</footer>
			)
		}
		<script>
			import { initApp } from "../examples/main.js";
			initApp(document.body.dataset.app);
		</script>
	</body>
</html>
